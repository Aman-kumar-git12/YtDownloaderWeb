{
  "manifest_version": 3,
  "name": "Viewlens – video insights",
  "short_name": "Viewlens",
  "version": "1.7.0",
  "description": "See estimated earnings, the most replayed moments, channel comparisons and comment mood for the video you're watching.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Viewlens",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://m.youtube.com/*",
    "https://www.youtube.com/*",
    "https://returnyoutubedislikeapi.com/*",
    "https://sponsor.ajay.app/*",
    "https://viewlens-api.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
